{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CMake: настроить копию 1",
      "type": "process",
      "command": "cmake",
      "args": [
        "-S",
        "versions/01_stage_1",
        "-B",
        "build/01_stage_1",
        "-G",
        "Visual Studio 17 2022",
        "-A",
        "x64"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "CMake: собрать копию 1",
      "type": "process",
      "command": "cmake",
      "args": [
        "--build",
        "build/01_stage_1",
        "--config",
        "RelWithDebInfo",
        "--",
        "/m:1",
        "/nr:false"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "CMake: настроить копию 1",
      "problemMatcher": [
        "$msCompile"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "CTest: проверить копию 1",
      "type": "process",
      "command": "ctest",
      "args": [
        "--test-dir",
        "build/01_stage_1",
        "-C",
        "RelWithDebInfo",
        "--output-on-failure"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "CMake: собрать копию 1",
      "problemMatcher": []
